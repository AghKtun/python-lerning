# Rearrangement of digit

num = int(input())

c = num % 10 ** (3 + 1 - 3) // (10 ** (3 - 3))
b = num % 10 ** (3 + 1 - 2) // (10 ** (3 - 2))
a = num % 10 ** (3 + 1 - 1) // (10 ** (3 - 1))
 
print(a, b, c, sep='')
print(a, c, b, sep='')
print(b, a, c, sep='')
print(b, c, a, sep='')
print(c, a, b, sep='')
print(c, b, a, sep='')
